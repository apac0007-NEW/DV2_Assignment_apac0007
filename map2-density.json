{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Night map of Brisbane: events per hexagon, brighter hexagons hold more events, festival and market venues shown as pink dots",
  "config": {
    "view": {
      "stroke": null,
      "fill": "#0e1a33"
    },
    "font": "Source Serif 4",
    "axis": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#39425a",
      "titleColor": "#39425a",
      "gridColor": "#e8ebf3",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#39425a",
      "titleColor": "#1d2540",
      "titleLimit": 320
    },
    "text": {
      "font": "Source Serif 4"
    }
  },
  "usermeta": {
    "map": true,
    "w0": 560,
    "h0": 470,
    "scale0": 72498
  },
  "width": 560,
  "height": 470,
  "projection": {
    "type": "mercator",
    "center": [
      153.055,
      -27.47
    ],
    "scale": 72498
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "a": 1
          }
        ]
      },
      "mark": {
        "type": "rect",
        "x": 0,
        "y": 0,
        "x2": "width",
        "y2": "height",
        "fill": "#0e1a33",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "states.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#24395f",
        "stroke": "#7891bd",
        "strokeWidth": 1.35
      }
    },
    {
      "data": {
        "url": "hexgrid.json",
        "format": {
          "property": "features"
        }
      },
      "params": [
        {
          "name": "hov",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeJoin": "round",
        "opacity": 0.92
      },
      "encoding": {
        "stroke": {
          "condition": {
            "param": "hov",
            "empty": false,
            "value": "#ffffff"
          },
          "value": "#10213b"
        },
        "strokeWidth": {
          "condition": {
            "param": "hov",
            "empty": false,
            "value": 2.5
          },
          "value": 1.05
        },
        "color": {
          "field": "properties.n",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              10,
              40,
              120,
              302
            ],
            "range": [
              "#10294a",
              "#0f6b7a",
              "#1fb5a0",
              "#7ae08f",
              "#f6f08a"
            ],
            "clamp": true
          },
          "legend": {
            "title": "Events per hexagon",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "gradientThickness": 12,
            "values": [
              1,
              50,
              150,
              300
            ],
            "labelColor": "#39425a",
            "titleColor": "#1d2540"
          }
        },
        "tooltip": [
          {
            "field": "properties.n",
            "type": "quantitative",
            "title": "Events"
          },
          {
            "field": "properties.types",
            "type": "quantitative",
            "title": "Kinds of event"
          }
        ]
      }
    },
    {
      "data": {
        "url": "venues_festival.json"
      },
      "mark": {
        "type": "circle",
        "size": 70,
        "color": "#ff4f98",
        "stroke": "#ffffff",
        "strokeWidth": 1.8,
        "opacity": 1
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "venue",
            "type": "nominal",
            "title": "Festival or market venue"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Events"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Chermside",
            "lat": -27.386,
            "lon": 153.034
          },
          {
            "name": "Indooroopilly",
            "lat": -27.5,
            "lon": 152.973
          },
          {
            "name": "Carindale",
            "lat": -27.505,
            "lon": 153.1
          },
          {
            "name": "Sunnybank",
            "lat": -27.576,
            "lon": 153.058
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontStyle": "italic",
        "color": "#ffffff",
        "stroke": "#0b1830",
        "strokeWidth": 1.35,
        "paintOrder": "stroke",
        "align": "left",
        "dx": 7,
        "dy": -7,
        "fontWeight": 700,
        "strokeJoin": "round"
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -27.464113028655234,
            "lon": 153.03361705194058,
            "t": "Densest hexagon: 302 events"
          }
        ]
      },
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700,
            "align": "right",
            "dx": -22,
            "dy": -24,
            "color": "#fff3b0",
            "stroke": "#0b1830",
            "strokeWidth": 1.5,
            "strokeJoin": "round"
          }
        }
      ]
    }
  ]
}
